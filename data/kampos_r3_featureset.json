    { "id": "MXP_009", "category": "MXP", "description": "Total ports cannot exceed 8 (mxp_drc.rb:136)", "severity": "error" },
    { "id": "CAL_001", "category": "CAL", "description": "CAL device count must match CAL type way count (cal20=2, cal40=4)", "severity": "error" },
    { "id": "CAL_002", "category": "CAL", "description": "Without CAL, only 1 device per port", "severity": "error" },
    { "id": "CAL_003", "category": "CAL", "description": "Device parametrization must be identical behind same CAL", "severity": "warning" },
    { "id": "CAL_004", "category": "CAL", "description": "A4S count must match for devices on same CAL", "severity": "warning" },
    { "id": "CAL_005", "category": "CAL", "description": "AXU count must match for devices on same CAL", "severity": "warning" },
    { "id": "CAL_006", "category": "CAL", "description": "CDB must be all or none for devices on same CAL", "severity": "error" },
    { "id": "CAL_007", "category": "CAL", "description": "ADB must be all or none for devices on same CAL", "severity": "error" },
    { "id": "CAL_008", "category": "CAL", "description": "CAL type must be supported for the device type", "severity": "error" },
    { "id": "DEV_001", "category": "DEVICE", "description": "Device count must be within allowed range (feature_drc.rb:21-36 Device count max/min). DSA mode (DSA_EN=1) relaxes HNF/HNS/LCN min to 0", "severity": "error" },
    { "id": "DEV_002", "category": "DEVICE", "description": "Group total count must be within group range (feature_drc.rb:38-66 Device group max/min). rn group includes CCG(PCIe). Skips sum check if any individual device exceeds max", "severity": "error" },
    { "id": "DEV_003", "category": "DEVICE", "description": "AXU count must be 0 or 1", "severity": "error" },
    { "id": "DEV_004", "category": "DEVICE", "description": "Feature not supported by device type", "severity": "error" },
    { "id": "DEV_010", "category": "DEVICE", "description": "At least 1 HND (Debug Home Node) required when devices are present", "severity": "error" },
    { "id": "DEV_012", "category": "DEVICE", "description": "Device group count below minimum (feature_drc.rb:62-63)", "severity": "error" },
    { "id": "DEV_014", "category": "DEVICE", "description": "Device type not supported (feature_drc.rb:68-76 Device type)", "severity": "error" },
